# =========================================================
# Smart Student Portal — Git ignore rules
# =========================================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.sample

# Dependencies
node_modules/
**/node_modules/

# Build output
dist/
build/
coverage/
.nyc_output/
.vite/
.cache/
.tmp/
temp/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime data and process files
pids/
*.pid
*.seed
*.pid.lock

# Local databases and database exports
*.sqlite
*.sqlite3
*.db
*.dump
*.sql.gz
*.bak
*.backup

# Uploaded files and generated documents
# Keep only explicitly committed placeholders/documentation.
server/uploads/*
!server/uploads/.gitkeep
uploads/*
!uploads/.gitkeep
storage/*
!storage/.gitkeep
*.pdf
*.doc
*.docx

# Generated certificates and private student documents
certificates/
generated/
private/
student-documents/

# Frontend / tooling caches
.eslintcache
.stylelintcache
*.tsbuildinfo

# Operating system files
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini

# Editor and IDE settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*.swo
*~

# Test artifacts
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# Temporary archives and exported project bundles
*.zip
*.rar
*.7z
*.tar
*.gz

# Keep intentional project assets; do not ignore all images.
